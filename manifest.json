{
  "manifest_version": 3,
  "name": "BOSS 职位复制助手",
  "version": "1.1.1",
  "description": "在 BOSS 直聘详情页一键复制招聘文本，方便粘贴到 AI 工具；不提供岗位、薪资或公司分析功能。",
  "homepage_url": "https://github.com/imRikyingit/boss-job-copy",
  "permissions": ["clipboardWrite"],
  "content_scripts": [
    {
      "matches": ["*://*.zhipin.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
